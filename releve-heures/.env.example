# Airtable
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Les tables sont ciblées par leur identifiant Airtable (voir TABLES dans
# src/lib/airtable.ts). Ces variables ne servent qu'à pointer l'app vers une
# autre base — laisser vide sinon.
# AIRTABLE_TABLE_INTERVENANTS=tblXXXXXXXXXXXXXX
# AIRTABLE_TABLE_CLIENTS=tblXXXXXXXXXXXXXX
# AIRTABLE_TABLE_RELEVES=tblXXXXXXXXXXXXXX
# AIRTABLE_TABLE_FICHES_PAIE=tblXXXXXXXXXXXXXX
# AIRTABLE_TABLE_MODIFICATIONS_PROFIL=tblXXXXXXXXXXXXXX

# NextAuth — générer avec: npx auth secret
AUTH_SECRET=
